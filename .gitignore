# ── Never commit copyrighted game material ──────────────────────────────
*.iso
*.ISO
*.bin
*.cue
*.mds
*.mdf
*.hog
*.HOG
*.exe
*.dll
*.bik
*.tga
*.spr
*.shp
*.fat
*.mp3
*.wav
*.agg
*.grp
*.zip
*.7z
*.rar
*.cab

# Local working dirs (game installs, disc images, extracted assets)
/game/
/original/
/disc/
/assets/
/extracted/

# Build / scratch
# Unanchored on purpose: PyInstaller runs from tools/, so the artefacts land in
# tools/build/ and tools/dist/. Root-anchored patterns missed those, leaving the
# whole build tree merely untracked, one `git add -A` away from being published.
# NOTE: /assets/ below stays root-anchored - tools/assets/app.ico IS tracked.
build/
dist/
tools/*.spec
__pycache__/
*.pyc
*.pyo
*.slpatch.json     # sl_patch sidecar manifests (only ever beside a patched local exe)
# native build artifacts (the xinput_shim is published as SOURCE only)
*.obj
*.lib
*.exp
*.ilk
*.pdb

# OS / editor
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# Local working log (private — not part of the published project)
PROJECT-LOG.md

# -- Hardening: RE artifacts / decrypted derivatives (never publish) --
*.icd
*.ICD
LANCER_decrypted*
*.gpr
*.rep
*.idb
*.i64
*.fm8
*.iff
*.sav
dmodes.bin
*stats.bin
*.decompiled.c
/analysis/
/exports/
